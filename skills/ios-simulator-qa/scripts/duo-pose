#!/bin/sh
# Set or read an iPhone Duo simulator's fold pose: duo-pose <UDID> get|closed|partial|open
# Compiles duo_pose.swift once per source and compiler version into a cache, then runs it.
# How it works, exit codes and credits: the header of duo_pose.swift.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
src="$here/duo_pose.swift"
cache="${XDG_CACHE_HOME:-$HOME/Library/Caches}/ios-simulator-qa"
key=$( { cat "$src"; xcrun swiftc --version 2>&1; } | shasum | cut -c1-12)
bin="$cache/duo-pose-$key"
if [ ! -x "$bin" ]; then
  mkdir -p "$cache"
  tmp="$bin.tmp.$$"
  xcrun swiftc -O "$src" -o "$tmp" || { rm -f "$tmp"; echo "duo-pose: could not compile $src" >&2; exit 3; }
  # Concurrent first runs each build their own file and rename it into place; the last one wins
  # and the result is the same. Old builds are never pruned here, because another invocation may
  # be using one; delete the cache directory by hand to reclaim the space.
  mv -f "$tmp" "$bin" || [ -x "$bin" ] || { echo "duo-pose: could not publish $bin" >&2; exit 3; }
fi
exec "$bin" "$@"
